# Copy this file to `.env` and fill in your values.
# `app/main.py` calls `dotenv.load_dotenv()` at startup so anything here
# becomes available to the services.

# Google Gemini API key, used by /api/ai-search.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google Maps Platform key for /api/places/autocomplete.
# Must have Places API enabled and billing attached on Google Cloud.
GOOGLE_MAPS_API_KEY=

# Optional: override the Gemini model. Defaults to gemini-2.0-flash.
# GEMINI_MODEL=gemini-2.0-flash
